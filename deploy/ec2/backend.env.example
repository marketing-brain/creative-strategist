# Copy to /etc/creative-strategist/backend.env on the box (owner root, chmod 600),
# fill in real values, then run setup.sh. Same variables as the repo's own
# .env.example -- the only EC2-specific changes are the *_BASE_URL /
# CORS_ORIGINS lines, which must point at this box's public IP or domain
# instead of localhost.

DATABASE_URL=
BLOB_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

CLERK_JWKS_URL=
CLERK_ISSUER=

# Replace with this box's Elastic IP or domain -- these are read by the app
# itself (e.g. Fivetran connect-card redirects), not baked at build time.
PUBLIC_BASE_URL=http://YOUR_EC2_IP:8000
WEB_BASE_URL=http://YOUR_EC2_IP:3000
CORS_ORIGINS=http://YOUR_EC2_IP:3000

FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=

# All LLM calls go through AI Gateway -- no Claude/Anthropic dependency.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
TAGGING_MODEL=google/gemini-2.5-flash-lite
INSIGHTS_MODEL=google/gemini-2.5-flash-lite
COPY_MODEL=google/gemini-3-flash
COPILOT_MODEL=google/gemini-3-flash
IMAGE_MODEL=bfl/flux-2-pro
VIDEO_MODEL=klingai/kling-v3.0-i2v
TRANSCRIPTION_MODEL=openai/whisper-1
EMBEDDING_MODEL=openai/text-embedding-3-small

# Jobs one cs-worker process runs at once (code default 1). 4 on the box.
WORKER_CONCURRENCY=4
