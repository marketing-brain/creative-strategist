DATABASE_URL=postgres://cs:cs@localhost:5432/cs?sslmode=disable
DATABASE_URL_TEST=postgres://cs:cs@localhost:5432/cs_test?sslmode=disable
# local | s3
BLOB_BACKEND=local
BLOB_ROOT=./var/blobs
S3_BUCKET=cs-blobs
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
# Required: create a Clerk application and fill these in. There is no dev-mode
# auth bypass -- every environment authenticates through Clerk.
CLERK_JWKS_URL=
CLERK_ISSUER=
PUBLIC_BASE_URL=http://localhost:8000
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=
WEB_BASE_URL=http://localhost:3000
# All LLM calls (tagging, insight explanations, copywriting, Copilot chat) go
# through AI Gateway -- there is no Claude/Anthropic dependency anywhere in
# this app. Defaults below match src/cs/core/config.py; override only to
# point a call site at a different AI-Gateway model.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
TAGGING_MODEL=google/gemini-2.5-flash-lite
INSIGHTS_MODEL=google/gemini-2.5-flash-lite
COPY_MODEL=google/gemini-3-flash
COPILOT_MODEL=google/gemini-3-flash
IMAGE_MODEL=bfl/flux-2-pro
VIDEO_MODEL=klingai/kling-v3.0-i2v
TRANSCRIPTION_MODEL=openai/whisper-1
EMBEDDING_MODEL=openai/text-embedding-3-small
# Comma-separated list of origins allowed to make cross-origin requests to the API
# (e.g. the Next.js web app running on a different port in dev).
CORS_ORIGINS=http://localhost:3000
# Optional: powers meta.resolve_instagram_video, the fallback for video creatives
# Fivetran can never expose (Meta "Partnership Ads" -- video owned by the creator's own
# Instagram account, not the ad account's video library). Leave blank to disable; those
# creatives are then just skipped, same as before this existed.
APIFY_API_KEY=
